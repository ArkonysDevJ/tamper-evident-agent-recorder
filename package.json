{
  "name": "tamper-evident-agent-recorder",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "description": "TEAR: a tamper-evident recorder for AI agent actions, anchored with RFC 3161 timestamps.",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "bin": {
    "tear-verify": "dist/src/cli/tear-verify.js"
  },
  "scripts": {
    "build": "tsc && node -e \"require('node:fs').chmodSync('dist/src/cli/tear-verify.js', 0o755)\"",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test \"dist/test/unit/**/*.test.js\"",
    "test:pg": "npm run build && node --test --test-concurrency=1 \"dist/test/pg/**/*.test.js\"",
    "fixture:build": "npm run build && node dist/test/fixture-tools/build-frozen-fixture.js",
    "test:local": "npm run build && node --test \"dist/test/local/**/*.test.js\"",
    "test:tamper": "npm run build && node --test --test-concurrency=1 \"dist/test/tamper/**/*.test.js\"",
    "tamper:receipts": "npm run build && node dist/test/fixture-tools/build-tamper-receipts.js",
    "m3": "npm run build && node dist/test/m3/run-m3.js",
    "m3:render": "npm run build && node dist/test/m3/render-m3.js"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "fs-ext": "2.1.1",
    "pg": "8.16.3"
  },
  "allowScripts": {
    "fs-ext@2.1.1": true
  }
}
